# Entorno de la aplicación
ASPNETCORE_ENVIRONMENT=Development

# Cadena de conexión de la base de datos SQLite
ConnectionStrings__DefaultConnection=Data Source=/app/data/roulette.db

# Contraseña de encriptación de la base de datos (opcional)
# Si se proporciona, la base de datos será encriptada con SQLCipher (AES-256)
# ⚠️ IMPORTANTE: No pierdas esta contraseña, sin ella no podrás acceder a los datos
Database__EncryptionPassword=TuContraseñaSuperSegura123!

# Configuración de Redis
Redis__ConnectionString=redis:6379
Redis__InstanceName=roulette:

# Configuración de JWT
Jwt__Key=MiClaveJWT_Super_Secreta_1234
Jwt__Issuer=Roulette.API
Jwt__Audience=Roulette.Client
Jwt__ExpirationMinutes=60
