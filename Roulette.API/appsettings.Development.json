{
    "ConnectionStrings": {
        "DefaultConnection": "Data Source=roulette_dev.db"
    },
    "Database": {
        "EncryptionPassword": "dev-key123!3432efdasASAD!@8*&"
    },
    "Redis": {
        "ConnectionString": "localhost:6379",
        "InstanceName": "roulette_dev:",
        "DefaultTimeoutInSeconds": 60
    },
    "Jwt": {
        "Key": "dev-key-123456789012345678901234567890",
        "Issuer": "Roulette.API.Dev",
        "Audience": "Roulette.Client.Dev",
        "ExpirationMinutes": 60
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
        "MinimumLevel": {
            "Default": "Debug",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": { "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact" }
            },
            {
                "Name": "File",
                "Args": {
                    "path": "logs/roulette-dev-.log",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 5
                }
            }
        ],
        "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
        "Properties": {
            "Application": "Roulette.API.Dev"
        }
    }
}
